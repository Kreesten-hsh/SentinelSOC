# SentinelSOC — Environment Configuration
# Copy this file to .env and fill in the values

# === LLM Configuration ===
# Default: Ollama local (installed via setup.sh)
LLM_PROVIDER=ollama
LLM_MODEL=ollama/mistral
OLLAMA_BASE_URL=http://localhost:11434

# Alternative: Hugging Face Inference API
# LLM_PROVIDER=huggingface
# HF_TOKEN=hf_your_token_here

# === Threat Intelligence (optional — local mode used by default) ===
# AbuseIPDB: https://www.abuseipdb.com/account/api
# ABUSEIPDB_API_KEY=your_key_here

# VirusTotal: https://www.virustotal.com/gui/my-apikey
# VIRUSTOTAL_API_KEY=your_key_here

# === Database ===
DATABASE_URL=sqlite+aiosqlite:///./sentinelsoc.db

# === API ===
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
